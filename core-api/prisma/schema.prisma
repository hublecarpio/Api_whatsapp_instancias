enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_VOUCHER
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id                    String      @id @default(uuid())
  businessId            String
  instanceId            String?
  contactPhone          String
  contactName           String?
  email                 String?
  shippingAddress       String?
  shippingCity          String?
  shippingState         String?
  shippingZip           String?
  shippingCountry       String?
  locationCoordinates   String?
  deliveryZoneId        String?
  notes                 String?
  totalAmount           Float
  subtotalAmount        Float?
  shippingCost          Float?      @default(0)
  paidAmount            Float       @default(0)
  pendingAmount         Float?
  currencyCode          String      @default("PEN")
  currencySymbol        String      @default("S/.")
  status                OrderStatus @default(PENDING_PAYMENT)
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  paidAt                DateTime?
  voucherImageUrl       String?
  voucherReceivedAt     DateTime?
  lastVoucherAmount     Float?
  lastVoucherBank       String?
  deliveryAgentName     String?
  deliveryAgentPhone    String?
  deliveryNotes         String?
  deliveredAt           DateTime?
  preparationStartedAt  DateTime?
  shippedAt             DateTime?
  promotionId           String?
  promotionName         String?
  discountType          String?
  discountValue         Float?
  discountAmount        Float?      @default(0)
  giftItems             String?
  idempotencyKey        String?
  orderSource           String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  items     OrderItem[]
  instance  WhatsAppInstance? @relation("OrderInstance", fields: [instanceId], references: [id], onDelete: SetNull)
  promotion Promotion?        @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@unique([businessId, contactPhone, idempotencyKey])
  @@index([businessId, status])
  @@index([businessId, contactPhone])
  @@index([businessId, instanceId])
  @@index([createdAt])
  @@index([promotionId])
  @@index([idempotencyKey])
}

model Promotion {
  id             String    @id @default(uuid())
  businessId     String
  instanceId     String?
