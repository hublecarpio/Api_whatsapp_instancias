datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  ASESOR
}

model User {
  id                          String              @id @default(uuid())
  name                        String
  email                       String              @unique
  phone                       String?
  pendingPhone                String?
  phoneVerified               Boolean             @default(false)
  phoneVerificationCode       String?
  phoneVerificationExpiresAt  DateTime?
  lastPhoneVerificationSentAt DateTime?
  passwordHash                String?
  googleId                    String?             @unique
  googlePicture               String?
  role                        UserRole            @default(ADMIN)
  parentUserId                String?
  emailVerified               Boolean             @default(false)
  verificationToken           String?
  verificationTokenExpiresAt  DateTime?
  lastVerificationSentAt      DateTime?
  passwordResetToken          String?
  passwordResetExpiresAt      DateTime?
  lastPasswordResetSentAt     DateTime?
  stripeCustomerId            String?
  stripeSubscriptionId        String?
  subscriptionStatus          SubscriptionStatus  @default(PENDING)
  subscriptionTier            SubscriptionTier    @default(BASIC)
  trialEndAt                  DateTime?
  isPro                       Boolean             @default(false)
  paymentLinkEnabled          Boolean             @default(false)
  proBonusExpiresAt           DateTime?
  stripePausedAt              DateTime?
  referralCode                String?
  referralCodeId              String?             // FK to the referral code used at registration
  bonusTokens                 Int                 @default(0)
  bonusDemoDays               Int                 @default(0) // Extra demo days granted at registration
  bonusTrialDays              Int                 @default(0) // Extra Stripe trial days granted at registration
  demoStartedAt               DateTime?
  demoPhase                   String              @default("DEMO")
  createdAt                   DateTime            @default(now())
  businesses                  Business[]
  subscriptions               Subscription[]
  parentUser                  User?               @relation("UserAdvisors", fields: [parentUserId], references: [id])
  advisors                    User[]              @relation("UserAdvisors")
  advisorInvitations          AdvisorInvitation[] @relation("InvitedBy")
  contactAssignments          ContactAssignment[]
  ownedReferralCodes          ReferralCode[]      @relation("UserReferralCodes")
  referredByCode              ReferralCode?       @relation("ReferredByCode", fields: [referralCodeId], references: [id], onDelete: SetNull)
  platformUserContacts        Contact[]           @relation("PlatformUserContacts")
  delegatedAgentFor           AgentDelegation[]   @relation("DelegatedAgent")
  delegatedAgentsOwned        AgentDelegation[]   @relation("DelegationOwner")
  businessRoles               UserBusinessRole[]
}

model AgentDelegation {
  id            String    @id @default(uuid())
  ownerId       String
  agentUserId   String    @unique
  isActive      Boolean   @default(true)
  assignedAt    DateTime  @default(now())
  deactivatedAt DateTime?

  owner         User      @relation("DelegationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  agentUser     User      @relation("DelegatedAgent", fields: [agentUserId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([agentUserId])
}

model AdvisorInvitation {
  id            String    @id @default(uuid())
  email         String
  token         String    @unique
  invitedById   String
  businessId    String
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())
  
  invitedBy     User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  @@unique([email, businessId])
}

enum BusinessRoleType {
  OWNER
  ADVISOR
}

model UserBusinessRole {
  id          String           @id @default(uuid())
  userId      String
  businessId  String
  role        BusinessRoleType
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId, isActive])
  @@index([businessId])
}

model ContactAssignment {
  id           String   @id @default(uuid())
  businessId   String
  contactPhone String
  userId       String
  assignedAt   DateTime @default(now())
  
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([businessId, contactPhone])
}

model Contact {
  id              String    @id @default(uuid())
  businessId      String
  phone           String
  name            String?
  email           String?
  tags            String[]  @default([])
  notes           String?
  source          String?
  firstMessageAt  DateTime
  lastMessageAt   DateTime
  messageCount    Int       @default(1)
  isArchived      Boolean   @default(false)
  botDisabled     Boolean   @default(false)
  botTestEnabled  Boolean   @default(false)
  remindersPaused Boolean   @default(false)
  platformUserId  String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platformUser    User?     @relation("PlatformUserContacts", fields: [platformUserId], references: [id], onDelete: SetNull)

  @@unique([businessId, phone])
  @@index([businessId, isArchived])
  @@index([businessId, lastMessageAt])
  @@index([businessId, tags])
  @@index([platformUserId])
}

enum ReferralCodeType {
  STANDARD
  ENTERPRISE
}

enum SubscriptionTier {
  STANDARD
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionSource {
  STRIPE
  ENTERPRISE
  TRIAL
}

model ReferralCode {
  id                String            @id @default(uuid())
  code              String            @unique
  description       String?
  type              ReferralCodeType  @default(STANDARD)
  grantTier         SubscriptionTier?
  grantDurationDays Int?
  maxUses           Int?
  isActive          Boolean           @default(true)
  usageCount        Int               @default(0)
  createdAt         DateTime          @default(now())
  expiresAt         DateTime?
  
  // Affiliate program fields
  ownerUserId       String?           // User who owns this referral code (for affiliate tracking)
  bonusDemoDays     Int?              // Extra demo days (without card) - adds to default 2 days
  bonusTrialDays    Int?              // Extra Stripe trial days - adds to default 5 days
  commissionRate    Float             @default(0.20) // Commission rate (default 20%)
  
  owner             User?             @relation("UserReferralCodes", fields: [ownerUserId], references: [id], onDelete: SetNull)
  subscriptions     Subscription[]
  referredUsers     User[]            @relation("ReferredByCode")

  @@index([code])
  @@index([type, isActive])
  @@index([ownerUserId])
}

model Subscription {
  id              String             @id @default(uuid())
  userId          String
  source          SubscriptionSource
  tier            SubscriptionTier   @default(PRO)
  status          SubscriptionStatus @default(ACTIVE)
  startsAt        DateTime           @default(now())
  endsAt          DateTime?
  referralCodeId  String?
  activatedBy     String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode    ReferralCode?      @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([endsAt, status])
  @@index([source])
}

enum SystemEventType {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  BUSINESS_CREATED
  BUSINESS_UPDATED
  INSTANCE_CREATED
  INSTANCE_CONNECTED
  INSTANCE_DISCONNECTED
  INSTANCE_ERROR
  MESSAGE_SENT
  MESSAGE_RECEIVED
  AI_RESPONSE
  AI_ERROR
  ORDER_CREATED
  ORDER_PAID
  ORDER_SHIPPED
  ORDER_DELIVERED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  SUBSCRIPTION_STARTED
  SUBSCRIPTION_CANCELLED
  TOOL_EXECUTED
  TOOL_ERROR
  WEBHOOK_RECEIVED
  API_ERROR
  SYSTEM_ERROR
  REMINDER_SENT
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
}

enum EventSeverity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

model SystemEvent {
  id          String          @id @default(uuid())
  eventType   SystemEventType
  severity    EventSeverity   @default(INFO)
  source      String
  userId      String?
  businessId  String?
  instanceId  String?
  message     String
  details     Json?
  metadata    Json?
  ip          String?
  userAgent   String?
  duration    Int?
  createdAt   DateTime        @default(now())

  @@index([eventType, createdAt])
  @@index([severity, createdAt])
  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([source, createdAt])
}

enum SubscriptionStatus {
  PENDING
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BusinessObjective {
  SALES
  APPOINTMENTS
}

model Business {
  id                String             @id @default(uuid())
  userId            String
  name              String
  description       String?
  industry          String?
  logoUrl           String?
  openaiApiKey      String?
  openaiModel       String?            @default("gpt-4.1-mini")
  botEnabled        Boolean            @default(true)
  timezone          String             @default("America/Lima")
  agentVersion      String             @default("v1")
  agentV2Config     Json?
  currencyCode      String             @default("PEN")
  currencySymbol    String             @default("S/.")
  businessObjective BusinessObjective  @default(SALES)
  appointmentConfig Json?
  businessContext   Json?
  injectionCode     String?
  apiKeyHash        String?
  apiKeyPrefix      String?
  apiKeyCreatedAt   DateTime?
  webhookUrl        String?
  webhookEvents     String[]           @default([])
  webhookSecret     String?
  roundRobinEnabled Boolean            @default(false)
  roundRobinAdvisors String[]          @default([])
  roundRobinWeights  Json               @default("{}")
  roundRobinLastIndex Int              @default(0)
  onboardingCompleted Boolean          @default(false)
  onboardingSkipped   Boolean          @default(false)
  createdAt         DateTime           @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  instances         WhatsAppInstance[]
  products          Product[]
  policy            Policy?
  agentPrompts      AgentPrompt[]
  messages          MessageLog[]
  tags              Tag[]
  followUpConfigs   FollowUpConfig[]
  reminders         Reminder[]
  appointments      Appointment[]
  availability      BusinessAvailability[]
  advisorInvitations AdvisorInvitation[]
  contactAssignments ContactAssignment[]
  contacts           Contact[]
  googleCalendar    GoogleCalendarCredential?
  salesObjections   SalesObjection[]
  funnelStages      FunnelStage[]
  userRoles         UserBusinessRole[]
  deliveryZones     DeliveryZone[]
  knowledgeChunks   BusinessKnowledgeChunk[]
  promptSections    PromptSection[]
  configBackups     ConfigurationBackup[]
}

model GoogleCalendarCredential {
  id              String   @id @default(uuid())
  businessId      String   @unique
  accessToken     String
  refreshToken    String
  tokenExpiry     DateTime
  calendarId      String   @default("primary")
  syncEnabled     Boolean  @default(true)
  connectedEmail  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model DeliveryZone {
  id           String   @id @default(uuid())
  businessId   String
  instanceId   String?
  name         String
  districts    String[]
  address      String?
  cost         Float
  freeAbove    Float?
  deliveryTime String?
  policy       String?
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instance WhatsAppInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  @@index([businessId, isActive])
  @@index([businessId, order])
  @@index([businessId, instanceId])
}

enum WhatsAppProvider {
  BAILEYS
  META_CLOUD
  META_COEXIST
  META_MANAGED
}

model WhatsAppInstance {
  id                String           @id @default(uuid())
  businessId        String
  instanceNumber    Int              @default(1)
  name              String           @default("WhatsApp")
  provider          WhatsAppProvider @default(BAILEYS)
  instanceBackendId String?
  phoneNumber       String?
  status            String           @default("pending_qr")
  qr                String?
  isActive          Boolean          @default(true)
  botEnabled        Boolean          @default(true)
  lastConnection    DateTime?
  webhookConfig     Json?
  createdAt         DateTime         @default(now())
  archivedAt        DateTime?
  businessObjective BusinessObjective?
  
  apiKeyHash        String?
  apiKeyPrefix      String?
  webhookUrl        String?
  webhookSecret     String?
  webhookEvents     String[]          @default([])

  business              Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  metaCredential        MetaCredential?
  metaCoexistCredential MetaCoexistCredential?
  metaManagedCredential MetaManagedCredential?
  history               WhatsAppInstanceHistory[]
  reminders        Reminder[]
  appointments     Appointment[]
  broadcasts       BroadcastCampaign[]
  followUpConfig   FollowUpConfig?
  agentPrompt      AgentPrompt?
  tags             Tag[]
  products         Product[]                 @relation("ProductInstance")
  orders           Order[]                   @relation("OrderInstance")
  funnelStages     FunnelStage[]
  knowledgeChunks  BusinessKnowledgeChunk[]  @relation("KnowledgeChunkInstance")
  promptSections   PromptSection[]           @relation("PromptSectionInstance")
  deliveryZones    DeliveryZone[]

  @@unique([businessId, instanceNumber])
  @@index([businessId])
  @@index([apiKeyPrefix])
  @@index([businessId, archivedAt])
}

enum InstanceEventType {
  CREATED
  CONNECTED
  DISCONNECTED
  PROVIDER_CHANGED
  DELETED
  RECONNECTED
  QR_GENERATED
  SESSION_EXPIRED
  ERROR
}

model WhatsAppInstanceHistory {
  id              String            @id @default(uuid())
  instanceId      String?
  businessId      String
  eventType       InstanceEventType
  previousProvider WhatsAppProvider?
  newProvider     WhatsAppProvider?
  previousStatus  String?
  newStatus       String?
  phoneNumber     String?
  backendId       String?
  details         String?
  metadata        Json?
  createdAt       DateTime          @default(now())

  instance WhatsAppInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([instanceId, createdAt])
}

model MetaCredential {
  id                 String   @id @default(uuid())
  instanceId         String   @unique
  accessToken        String
  businessId         String
  phoneNumberId      String
  appId              String
  appSecret          String
  webhookVerifyToken String   @default(uuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  instance  WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  templates MetaTemplate[]
}

enum MetaCoexistStatus {
  PENDING
  AWAITING_QR
  CONNECTED
  ACTIVE
  REVOKED
  BLOCKED
  DISABLED
}

model MetaCoexistCredential {
  id                   String             @id @default(uuid())
  instanceId           String             @unique
  wabaId               String
  metaBusinessId       String
  phoneNumberId        String
  displayPhone         String?
  userAccessToken      String
  systemAccessToken    String?
  tokenExpiresAt       DateTime?
  webhookVerifyToken   String             @default(uuid())
  coexistenceEnabled   Boolean            @default(false)
  coexistStatus        MetaCoexistStatus  @default(PENDING)
  qualityRating        String?
  messagingTier        String?
  sessionId            String?
  lastSyncAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  instance   WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  templates  MetaTemplate[]

  @@index([wabaId])
  @@index([phoneNumberId])
}

enum MetaManagedStatus {
  PENDING_REGISTRATION
  PENDING_VERIFICATION
  VERIFICATION_FAILED
  ACTIVE
  SUSPENDED
  DISCONNECTED
}

model MetaManagedCredential {
  id                   String              @id @default(uuid())
  instanceId           String              @unique
  phoneNumberId        String
  displayPhone         String
  verifiedName         String?
  qualityRating        String?
  messagingTier        String?
  status               MetaManagedStatus   @default(PENDING_REGISTRATION)
  registrationCode     String?
  registrationMethod   String              @default("SMS")
  verificationAttempts Int                 @default(0)
  lastVerificationAt   DateTime?
  registeredAt         DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  instance  WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  templates MetaTemplate[]

  @@index([phoneNumberId])
  @@index([displayPhone])
}

model MetaTemplate {
  id                   String   @id @default(uuid())
  credentialId         String?
  coexistCredentialId  String?
  managedCredentialId  String?
  metaTemplateId       String
  name                 String
  language             String   @default("es")
  category             String   @default("UTILITY")
  status               String   @default("PENDING")
  components           Json
  headerType           String?
  bodyText             String?
  footerText           String?
  buttons              Json?
  lastSynced           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  credential         MetaCredential?          @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  coexistCredential  MetaCoexistCredential?   @relation(fields: [coexistCredentialId], references: [id], onDelete: Cascade)
  managedCredential  MetaManagedCredential?   @relation(fields: [managedCredentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, name])
  @@unique([coexistCredentialId, name])
  @@unique([managedCredentialId, name])
  @@index([credentialId, status])
  @@index([coexistCredentialId, status])
  @@index([managedCredentialId, status])
}

model Product {
  id                  String   @id @default(uuid())
  businessId          String
  instanceId          String?
  title               String
  description         String?
  variations          String[] @default([])
  pricePerVariation   Float[]  @default([])
  stockPerVariation   Int[]    @default([])
  imageUrls           String[] @default([])
  price               Float    @default(0)
  stock               Int      @default(0)
  imageUrl            String?
  createdAt           DateTime @default(now())

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instance WhatsAppInstance? @relation("ProductInstance", fields: [instanceId], references: [id], onDelete: SetNull)

  @@index([businessId, title])
  @@index([businessId, instanceId])
}

model Policy {
  id             String  @id @default(uuid())
  businessId     String  @unique
  shippingPolicy String?
  refundPolicy   String?
  brandVoice     String?
  allowedHours   String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model AgentPrompt {
  id            String            @id @default(uuid())
  businessId    String
  instanceId    String?           @unique
  prompt        String
  bufferSeconds Int               @default(0)
  historyLimit  Int               @default(10)
  splitMessages Boolean           @default(true)
  updatedAt     DateTime          @default(now())

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instance WhatsAppInstance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  tools    AgentTool[]
  files    AgentFile[]

  @@index([businessId])
}

model AgentFile {
  id          String   @id @default(uuid())
  promptId    String
  name        String
  description String?
  fileUrl     String
  fileType    String   @default("document")
  triggerKeywords String?
  triggerContext  String?
  order       Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prompt AgentPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId, enabled])
  @@index([promptId, order])
}

enum KnowledgeCategory {
  BUSINESS_INFO
  PRODUCTS
  POLICIES
  FAQ
  PROCESSES
  OBJECTIONS
  DELIVERY
  PROMOTIONS
  CUSTOM
}

model BusinessKnowledgeChunk {
  id          String            @id @default(uuid())
  businessId  String
  instanceId  String?
  category    KnowledgeCategory
  title       String
  content     String
  embedding   Float[]
  keywords    String[]          @default([])
  priority    Int               @default(0)
  isActive    Boolean           @default(true)
  sourceType  String            @default("manual")
  sourceId    String?
  metadata    Json?
  tokenCount  Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instance WhatsAppInstance? @relation("KnowledgeChunkInstance", fields: [instanceId], references: [id], onDelete: SetNull)

  @@index([businessId, category])
  @@index([businessId, instanceId, category])
  @@index([businessId, isActive])
}

model AgentTool {
  id          String  @id @default(uuid())
  promptId    String
  name        String
  description String
  url         String
  method      String  @default("POST")
  headers     Json?
  bodyTemplate Json?
  parameters  Json?
  dynamicVariables Json?
  enabled     Boolean @default(true)

  prompt AgentPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  logs   ToolLog[]
}

model ToolLog {
  id          String   @id @default(uuid())
  toolId      String
  businessId  String
  contactPhone String?
  request     Json
  response    Json?
  status      String   @default("success")
  duration    Int?
  createdAt   DateTime @default(now())

  tool AgentTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

enum IntentType {
  GREETING
  PRODUCT_INQUIRY
  PRICE_INQUIRY
  OBJECTION
  READY_TO_BUY
  SCHEDULE_APPOINTMENT
  SUPPORT_REQUEST
  COMPLAINT
  FOLLOWUP
  CLOSING
  OTHER
}

model SalesObjection {
  id              String   @id @default(uuid())
  businessId      String
  name            String
  triggerPhrases  String[]
  responseScript  String
  priority        Int      @default(0)
  isActive        Boolean  @default(true)
  category        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isActive])
  @@index([businessId, category])
}

model FunnelStage {
  id                String   @id @default(uuid())
  businessId        String
  instanceId        String?
  name              String
  order             Int      @default(0)
  description       String?
  promptContext     String?
  toolsAllowed      String[]
  requiredFieldKeys String[] @default([])
  blockedTopics     String[] @default([])
  autoTransition    Json?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instance WhatsAppInstance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  contacts ContactFunnelState[]

  @@unique([businessId, name, instanceId])
  @@index([businessId, order])
  @@index([businessId, isActive])
  @@index([instanceId])
}

model ContactFunnelState {
  id              String    @id @default(uuid())
  businessId      String
  contactPhone    String
  stageId         String
  enteredAt       DateTime  @default(now())
  lastInteraction DateTime?
  metadata        Json?

  stage FunnelStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([businessId, contactPhone])
  @@index([stageId])
}

model IntentLog {
  id              String     @id @default(uuid())
  businessId      String
  contactPhone    String
  messageId       String?
  detectedIntent  IntentType
  confidence      Float
  objectionId     String?
  reasoning       String?
  createdAt       DateTime   @default(now())

  @@index([businessId, contactPhone])
  @@index([businessId, detectedIntent])
}

model MessageBuffer {
  id              String    @id @default(uuid())
  businessId      String
  contactPhone    String
  instanceId      String?
  messages        Json
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  processingUntil DateTime?
  retryCount      Int       @default(0)
  failedAt        DateTime?
  failureReason   String?

  @@unique([businessId, contactPhone])
  @@index([expiresAt, processingUntil])
  @@index([failedAt])
}

model MessageLog {
  id                String   @id @default(uuid())
  businessId        String
  instanceId        String?
  providerMessageId String?
  direction         String
  sender            String?
  recipient         String?
  message           String?
  mediaUrl          String?
  metadata          Json?
  deliveryStatus    String?  @default("sent")
  deliveryError     String?
  deliveryAttempts  Int      @default(0)
  createdAt         DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, providerMessageId])
}

model Tag {
  id          String   @id @default(uuid())
  businessId  String
  instanceId  String?
  name        String
  color       String   @default("#6B7280")
  description String?
  order       Int      @default(0)
  isDefault   Boolean  @default(false)
