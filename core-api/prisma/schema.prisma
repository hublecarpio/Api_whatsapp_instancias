generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String              @id @default(uuid())
  name                        String
  email                       String              @unique
  phone                       String?
  pendingPhone                String?
  phoneVerified               Boolean             @default(false)
  phoneVerificationCode       String?
  phoneVerificationExpiresAt  DateTime?
  lastPhoneVerificationSentAt DateTime?
  passwordHash                String?
  googleId                    String?             @unique
  googlePicture               String?
  role                        UserRole            @default(ADMIN)
  parentUserId                String?
  emailVerified               Boolean             @default(false)
  verificationToken           String?
  verificationTokenExpiresAt  DateTime?
  lastVerificationSentAt      DateTime?
  passwordResetToken          String?
  passwordResetExpiresAt      DateTime?
  lastPasswordResetSentAt     DateTime?
  stripeCustomerId            String?
  stripeSubscriptionId        String?
  subscriptionStatus          SubscriptionStatus  @default(PENDING)
  subscriptionTier            SubscriptionTier    @default(BASIC)
  trialEndAt                  DateTime?
  isPro                       Boolean             @default(false)
  paymentLinkEnabled          Boolean             @default(false)
  proBonusExpiresAt           DateTime?
  stripePausedAt              DateTime?
  referralCode                String?
  referralCodeId              String?
  bonusTokens                 Int                 @default(0)
  bonusDemoDays               Int                 @default(0)
  bonusTrialDays              Int                 @default(0)
  demoStartedAt               DateTime?
  demoPhase                   String              @default("DEMO")
  createdAt                   DateTime            @default(now())
  advisorInvitations          AdvisorInvitation[] @relation("InvitedBy")
  delegatedAgentFor           AgentDelegation?    @relation("DelegatedAgent")
  delegatedAgentsOwned        AgentDelegation[]   @relation("DelegationOwner")
  businesses                  Business[]
  platformUserContacts        Contact[]           @relation("PlatformUserContacts")
  contactAssignments          ContactAssignment[]
  ownedReferralCodes          ReferralCode[]      @relation("UserReferralCodes")
  subscriptions               Subscription[]
  parentUser                  User?               @relation("UserAdvisors", fields: [parentUserId], references: [id])
  advisors                    User[]              @relation("UserAdvisors")
  referredByCode              ReferralCode?       @relation("ReferredByCode", fields: [referralCodeId], references: [id])
  businessRoles               UserBusinessRole[]
}

model AgentDelegation {
  id            String    @id @default(uuid())
  ownerId       String
  agentUserId   String    @unique
  isActive      Boolean   @default(true)
  assignedAt    DateTime  @default(now())
  deactivatedAt DateTime?
  agentUser     User      @relation("DelegatedAgent", fields: [agentUserId], references: [id], onDelete: Cascade)
  owner         User      @relation("DelegationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([agentUserId])
}

model AdvisorInvitation {
  id          String    @id @default(uuid())
  email       String
  token       String    @unique
  invitedById String
  businessId  String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([email, businessId])
}

model UserBusinessRole {
  id         String           @id @default(uuid())
  userId     String
  businessId String
  role       BusinessRoleType
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId, isActive])
  @@index([businessId])
}

model ContactAssignment {
  id           String   @id @default(uuid())
  businessId   String
  contactPhone String
  userId       String
  assignedAt   DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, contactPhone])
}

model Contact {
  id              String   @id @default(uuid())
  businessId      String
  phone           String
  name            String?
  email           String?
  tags            String[] @default([])
  notes           String?
  source          String?
  firstMessageAt  DateTime
  lastMessageAt   DateTime
  messageCount    Int      @default(1)
  isArchived      Boolean  @default(false)
  botDisabled     Boolean  @default(false)
  botTestEnabled  Boolean  @default(false)
  remindersPaused Boolean  @default(false)
  platformUserId  String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platformUser    User?    @relation("PlatformUserContacts", fields: [platformUserId], references: [id])

  @@unique([businessId, phone])
  @@index([businessId, isArchived])
  @@index([businessId, lastMessageAt])
  @@index([businessId, tags])
  @@index([platformUserId])
}

model ReferralCode {
  id                String            @id @default(uuid())
  code              String            @unique
  description       String?
  type              ReferralCodeType  @default(STANDARD)
  grantTier         SubscriptionTier?
  grantDurationDays Int?
  maxUses           Int?
  isActive          Boolean           @default(true)
  usageCount        Int               @default(0)
  createdAt         DateTime          @default(now())
  expiresAt         DateTime?
  ownerUserId       String?
  bonusDemoDays     Int?
  bonusTrialDays    Int?
  commissionRate    Float             @default(0.20)
  owner             User?             @relation("UserReferralCodes", fields: [ownerUserId], references: [id])
  subscriptions     Subscription[]
  referredUsers     User[]            @relation("ReferredByCode")

  @@index([code])
  @@index([type, isActive])
  @@index([ownerUserId])
}

model Subscription {
  id             String             @id @default(uuid())
  userId         String
  source         SubscriptionSource
  tier           SubscriptionTier   @default(PRO)
  status         SubscriptionStatus @default(ACTIVE)
  startsAt       DateTime           @default(now())
  endsAt         DateTime?
  referralCodeId String?
  activatedBy    String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  referralCode   ReferralCode?      @relation(fields: [referralCodeId], references: [id])
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([endsAt, status])
  @@index([source])
}

model SystemEvent {
  id         String          @id @default(uuid())
  eventType  SystemEventType
  severity   EventSeverity   @default(INFO)
  source     String
  userId     String?
  businessId String?
  instanceId String?
  message    String
  details    Json?
  metadata   Json?
  ip         String?
  userAgent  String?
  duration   Int?
  createdAt  DateTime        @default(now())

  @@index([eventType, createdAt])
  @@index([severity, createdAt])
  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([source, createdAt])
}

model Business {
  id                  String                    @id @default(uuid())
  userId              String
  name                String
  description         String?
  industry            String?
  logoUrl             String?
  openaiApiKey        String?
  openaiModel         String?                   @default("gpt-4.1-mini")
  botEnabled          Boolean                   @default(true)
  timezone            String                    @default("America/Lima")
  agentVersion        String                    @default("v1")
  agentV2Config       Json?
  currencyCode        String                    @default("PEN")
  currencySymbol      String                    @default("S/.")
  businessObjective   BusinessObjective         @default(SALES)
  appointmentConfig   Json?
  businessContext     Json?
  injectionCode       String?
  apiKeyHash          String?
  apiKeyPrefix        String?
  apiKeyCreatedAt     DateTime?
  webhookUrl          String?
  webhookEvents       String[]                  @default([])
  webhookSecret       String?
  roundRobinEnabled   Boolean                   @default(false)
  roundRobinAdvisors  String[]                  @default([])
  roundRobinLastIndex Int                       @default(0)
  onboardingCompleted Boolean                   @default(false)
  onboardingSkipped   Boolean                   @default(false)
  createdAt           DateTime                  @default(now())
  roundRobinWeights   Json                      @default("{}")
  v3Llm1Model         String?                   @default("gpt-4.1-mini")
  v3Llm1Provider      String?                   @default("openai")
  v3Llm2Model         String?                   @default("gpt-4.1")
  v3Llm2Provider      String?                   @default("openai")
  slug                String?
  advisorInvitations  AdvisorInvitation[]
  agentPrompts        AgentPrompt[]
  appointments        Appointment[]
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability        BusinessAvailability[]
  knowledgeChunks     BusinessKnowledgeChunk[]
  configBackups       ConfigurationBackup[]
  contacts            Contact[]
  contactAssignments  ContactAssignment[]
  deliveryZones       DeliveryZone[]
  followUpConfigs     FollowUpConfig[]
  funnelStages        FunnelStage[]
  googleCalendar      GoogleCalendarCredential?
  messages            MessageLog[]
  policy              Policy?
  products            Product[]
  promptSections      PromptSection[]
  reminders           Reminder[]
  salesObjections     SalesObjection[]
  tags                Tag[]
  userRoles           UserBusinessRole[]
  instances           WhatsAppInstance[]
  quickReplies        QuickReply[]
}

model GoogleCalendarCredential {
  id             String   @id @default(uuid())
  businessId     String   @unique
  accessToken    String
  refreshToken   String
  tokenExpiry    DateTime
  calendarId     String   @default("primary")
  syncEnabled    Boolean  @default(true)
  connectedEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model DeliveryZone {
  id           String            @id @default(uuid())
  businessId   String
  instanceId   String?
  name         String
  districts    String[]
  address      String?
  cost         Float
  freeAbove    Float?
  deliveryTime String?
  policy       String?
  isActive     Boolean           @default(true)
  order        Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instance     WhatsAppInstance? @relation(fields: [instanceId], references: [id])

  @@index([businessId, isActive])
  @@index([businessId, order])
  @@index([businessId, instanceId])
}

model QuickReply {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  businessId String
  shortcut   String
  title      String
  message    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  order      Int      @default(0)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, shortcut])
}

model WhatsAppInstance {
  id                    String                    @id @default(uuid())
  businessId            String
  instanceNumber        Int                       @default(1)
  name                  String                    @default("WhatsApp")
  provider              WhatsAppProvider          @default(BAILEYS)
  instanceBackendId     String?
  phoneNumber           String?
  status                String                    @default("pending_qr")
  qr                    String?
  isActive              Boolean                   @default(true)
  botEnabled            Boolean                   @default(true)
  lastConnection        DateTime?
  webhookConfig         Json?
  createdAt             DateTime                  @default(now())
  archivedAt            DateTime?
  businessObjective     BusinessObjective?
  apiKeyHash            String?
  apiKeyPrefix          String?
  webhookUrl            String?
  webhookSecret         String?
  webhookEvents         String[]                  @default([])
  slug                  String?                   @unique
  catalogLogoUrl        String?
  agentPrompt           AgentPrompt?
  appointments          Appointment[]
  broadcasts            BroadcastCampaign[]
  knowledgeChunks       BusinessKnowledgeChunk[]  @relation("KnowledgeChunkInstance")
  deliveryZones         DeliveryZone[]
  followUpConfig        FollowUpConfig?
  funnelStages          FunnelStage[]
  metaCoexistCredential MetaCoexistCredential?
  metaCredential        MetaCredential?
  metaManagedCredential MetaManagedCredential?
  orders                Order[]                   @relation("OrderInstance")
  products              Product[]                 @relation("ProductInstance")
  promptSections        PromptSection[]           @relation("PromptSectionInstance")
  reminders             Reminder[]
  tags                  Tag[]
  business              Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  history               WhatsAppInstanceHistory[]

  @@unique([businessId, instanceNumber])
  @@index([businessId])
  @@index([apiKeyPrefix])
  @@index([businessId, archivedAt])
  @@index([slug])
}

model WhatsAppInstanceHistory {
  id               String            @id @default(uuid())
  instanceId       String?
  businessId       String
  eventType        InstanceEventType
  previousProvider WhatsAppProvider?
  newProvider      WhatsAppProvider?
  previousStatus   String?
  newStatus        String?
  phoneNumber      String?
  backendId        String?
  details          String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  instance         WhatsAppInstance? @relation(fields: [instanceId], references: [id])

  @@index([businessId, createdAt])
  @@index([instanceId, createdAt])
}

model MetaCredential {
  id                 String           @id @default(uuid())
  instanceId         String           @unique
  accessToken        String
  businessId         String
  phoneNumberId      String
  appId              String
  appSecret          String
  webhookVerifyToken String           @default(uuid())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  instance           WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  templates          MetaTemplate[]
}

model MetaCoexistCredential {
  id                 String            @id @default(uuid())
  instanceId         String            @unique
  wabaId             String
  metaBusinessId     String
  phoneNumberId      String
  displayPhone       String?
  userAccessToken    String
  systemAccessToken  String?
  tokenExpiresAt     DateTime?
  webhookVerifyToken String            @default(uuid())
  coexistenceEnabled Boolean           @default(false)
  coexistStatus      MetaCoexistStatus @default(PENDING)
  qualityRating      String?
  messagingTier      String?
  sessionId          String?
  lastSyncAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  instance           WhatsAppInstance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  templates          MetaTemplate[]

  @@index([wabaId])
  @@index([phoneNumberId])
}

model MetaManagedCredential {
  id                   String           @id @default(uuid())
  instanceId           String           @unique
  phoneNumberId        String
  displayPhone         String?
  verifiedName         String?
  status               String           @default("PENDING_VERIFICATION")
  qualityRating        String?
  messagingTier        String?
  registrationMethod   String           @default("SMS")
  registeredAt         DateTime?
  verificationAttempts Int              @default(0)
  lastVerificationAt   DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  instance             WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId])
}

model MediaShortUrl {
  id          String   @id @default(uuid())
  shortId     String   @unique
  originalUrl String
  businessId  String?
  mediaType   String?
  createdAt   DateTime @default(now())

  @@index([shortId])
  @@index([businessId])
  @@index([createdAt])
}

model MetaTemplate {
  id                  String                 @id @default(uuid())
  credentialId        String?
  coexistCredentialId String?
  metaTemplateId      String
  name                String
  language            String                 @default("es")
  category            String                 @default("UTILITY")
  status              String                 @default("PENDING")
  components          Json
  headerType          String?
  bodyText            String?
  footerText          String?
  buttons             Json?
  lastSynced          DateTime               @default(now())
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  managedCredentialId String?
  coexistCredential   MetaCoexistCredential? @relation(fields: [coexistCredentialId], references: [id], onDelete: Cascade)
  credential          MetaCredential?        @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, name])
  @@unique([coexistCredentialId, name])
  @@index([credentialId, status])
  @@index([coexistCredentialId, status])
}

model Product {
  id                 String            @id @default(uuid())
  businessId         String
  instanceId         String?
  title              String
  description        String?
  price              Float             @default(0)
  stock              Int               @default(0)
  imageUrl           String?
  createdAt          DateTime          @default(now())
  imageUrls          String[]          @default([])
  pricePerVariation  Float[]           @default([])
  stockPerVariation  Int[]             @default([])
  variations         String[]          @default([])
  embeddingText      String?
  embeddingUpdatedAt DateTime?
  business           Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instance           WhatsAppInstance? @relation("ProductInstance", fields: [instanceId], references: [id])

  @@index([businessId, title])
  @@index([businessId, instanceId])
}

model Policy {
  id             String   @id @default(uuid())
  businessId     String   @unique
  shippingPolicy String?
  refundPolicy   String?
  brandVoice     String?
  allowedHours   String?
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model AgentPrompt {
  id            String            @id @default(uuid())
  businessId    String
  instanceId    String?           @unique
  prompt        String
  bufferSeconds Int               @default(0)
  historyLimit  Int               @default(10)
  splitMessages Boolean           @default(true)
  updatedAt     DateTime          @default(now())
  files         AgentFile[]
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instance      WhatsAppInstance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  tools         AgentTool[]

  @@index([businessId])
}

model AgentFile {
  id              String      @id @default(uuid())
  promptId        String
  name            String
  description     String?
  fileUrl         String
  fileType        String      @default("document")
  triggerKeywords String?
  triggerContext  String?
  order           Int         @default(0)
  enabled         Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  prompt          AgentPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId, enabled])
  @@index([promptId, order])
}

model BusinessKnowledgeChunk {
  id         String            @id @default(uuid())
  businessId String
  instanceId String?
  category   KnowledgeCategory
  title      String
  content    String
  embedding  Float[]
  keywords   String[]          @default([])
  priority   Int               @default(0)
  isActive   Boolean           @default(true)
  sourceType String            @default("manual")
  sourceId   String?
  metadata   Json?
  tokenCount Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instance   WhatsAppInstance? @relation("KnowledgeChunkInstance", fields: [instanceId], references: [id])

  @@index([businessId, category])
  @@index([businessId, instanceId, category])
  @@index([businessId, isActive])
}

model AgentTool {
  id               String      @id @default(uuid())
  promptId         String
  name             String
  description      String
  url              String
  method           String      @default("POST")
  headers          Json?
  bodyTemplate     Json?
  parameters       Json?
  dynamicVariables Json?
  enabled          Boolean     @default(true)
  prompt           AgentPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  logs             ToolLog[]
}

model ToolLog {
  id           String    @id @default(uuid())
  toolId       String
  businessId   String
  contactPhone String?
  request      Json
  response     Json?
  status       String    @default("success")
  duration     Int?
  createdAt    DateTime  @default(now())
  tool         AgentTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

model SalesObjection {
  id             String   @id @default(uuid())
  businessId     String
  name           String
  triggerPhrases String[]
  responseScript String
  priority       Int      @default(0)
  isActive       Boolean  @default(true)
  category       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isActive])
  @@index([businessId, category])
}

model FunnelStage {
  id                String               @id @default(uuid())
  businessId        String
  instanceId        String?
  name              String
  order             Int                  @default(0)
  description       String?
  promptContext     String?
  toolsAllowed      String[]
  requiredFieldKeys String[]             @default([])
  blockedTopics     String[]             @default([])
  autoTransition    Json?
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt
  contacts          ContactFunnelState[]
  business          Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instance          WhatsAppInstance?    @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([businessId, name, instanceId])
  @@index([businessId, order])
  @@index([businessId, isActive])
  @@index([instanceId])
}

model ContactFunnelState {
  id              String      @id @default(uuid())
  businessId      String
  contactPhone    String
  stageId         String
  enteredAt       DateTime    @default(now())
  lastInteraction DateTime?
  metadata        Json?
  stage           FunnelStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([businessId, contactPhone])
  @@index([stageId])
}

model IntentLog {
  id             String     @id @default(uuid())
  businessId     String
  contactPhone   String
  messageId      String?
  detectedIntent IntentType
  confidence     Float
  objectionId    String?
  reasoning      String?
  createdAt      DateTime   @default(now())

  @@index([businessId, contactPhone])
  @@index([businessId, detectedIntent])
}

model MessageBuffer {
  id              String    @id @default(uuid())
  businessId      String
  contactPhone    String
  instanceId      String?
  messages        Json
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  processingUntil DateTime?
  retryCount      Int       @default(0)
  failedAt        DateTime?
  failureReason   String?

  @@unique([businessId, contactPhone])
  @@index([expiresAt, processingUntil])
  @@index([failedAt])
}

model MessageLog {
  id                String   @id @default(uuid())
  businessId        String
  instanceId        String?
  providerMessageId String?
  direction         String
  sender            String?
  recipient         String?
  message           String?
  mediaUrl          String?
  metadata          Json?
  createdAt         DateTime @default(now())
  deliveryAttempts  Int      @default(0)
  deliveryError     String?
  deliveryStatus    String?  @default("sent")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, providerMessageId])
}

model Tag {
  id          String            @id @default(uuid())
  businessId  String
  instanceId  String?
  name        String
  color       String            @default("#6B7280")
  description String?
  order       Int               @default(0)
  isDefault   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  type        String            @default("SYSTEM")
  stagePrompt StagePrompt?
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instance    WhatsAppInstance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  assignments TagAssignment[]
  history     TagHistory[]

  @@unique([businessId, name, instanceId])
  @@index([businessId, order])
  @@index([businessId, instanceId])
  @@index([businessId, type])
}

model TagAssignment {
  id           String   @id @default(uuid())
  tagId        String
  businessId   String
  contactPhone String
  assignedAt   DateTime @default(now())
  assignedBy   String?
  source       String   @default("manual")
  tag          Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([businessId, contactPhone, tagId])
  @@index([businessId, contactPhone])
  @@index([businessId, tagId])
  @@index([tagId])
}

model TagHistory {
  id           String    @id @default(uuid())
  tagId        String
  businessId   String
  contactPhone String
  assignedAt   DateTime  @default(now())
  removedAt    DateTime?
  source       String    @default("manual")
  notes        String?
  tag          Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([businessId, contactPhone])
  @@index([tagId, assignedAt])
}

model StagePrompt {
  id             String  @id @default(uuid())
  tagId          String  @unique
  promptOverride String?
  systemContext  String?
  toolsOverride  Json?
  tag            Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
}

model FollowUpConfig {
  id                 String            @id @default(uuid())
  businessId         String
  instanceId         String?           @unique
  enabled            Boolean           @default(false)
  firstDelayMinutes  Int               @default(15)
  secondDelayMinutes Int               @default(60)
